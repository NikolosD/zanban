{
  "name": "zanban",
  "version": "0.0.1",
  "description": "AI meeting assistant",
  "license": "MIT",
  "author": "Nikoloz Dolidze",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=1 electron-vite build",
    "bench:overlay": "electron scripts/bench/overlay-readability.mjs",
    "bench:overlay:compare": "node scripts/bench/overlay-readability.mjs --compare",
    "icons": "node scripts/generate-icons.cjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "postinstall": "node scripts/ensure-sqlite-vec.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/gateway": "3.0.107",
    "@anthropic-ai/sdk": "^0.92.0",
    "@deepgram/sdk": "^5.1.0",
    "@elevenlabs/elevenlabs-js": "^2.45.0",
    "@google-cloud/speech": "^7.3.0",
    "@google/genai": "^1.51.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.12",
    "groq-sdk": "^1.1.2",
    "mammoth": "^1.12.0",
    "openai": "^6.35.0",
    "sherpa-onnx-node": "2.0.1",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "unpdf": "1.8.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@img/sharp-win32-x64",
      "@img/sharp-darwin-x64",
      "@img/sharp-darwin-arm64",
      "@img/sharp-linux-x64"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "sharp": "^0.34.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^3.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "i18next": "^26.0.9",
    "lint-staged": "^17.0.0",
    "lucide-react": "^0.460.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.5",
    "zustand": "^5.0.2"
  }
}
