# Electron-builder packs node_modules from the top-level layout. pnpm's
# default nested .pnpm store layout breaks asarUnpack patterns like
# node_modules/sqlite-vec-windows-x64/** because the real files live under
# node_modules/.pnpm/sqlite-vec-windows-x64@x.y.z/node_modules/. Hoist the
# native-binary packages to the top level so packaging stays predictable.
public-hoist-pattern[]=*sqlite-vec*
public-hoist-pattern[]=*better-sqlite3*

# Allow optionalDependencies for cross-platform sqlite-vec binaries to be
# installed regardless of current host platform — useful for CI release
# builds that need binaries for a target other than the runner's OS.
side-effects-cache=false
