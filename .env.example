# Main process — loaded via dotenv at app start (dev only).
# In production, use the in-app Settings UI; values persist encrypted via safeStorage.

# Deepgram — streaming STT (Nova-3, multi-language).
DEEPGRAM_API_KEY=

# Vercel AI Gateway — single endpoint for DeepSeek (LLM) + Mimo (titles).
# Get a key at https://vercel.com/dashboard → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=
